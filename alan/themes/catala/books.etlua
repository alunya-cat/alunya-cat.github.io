<!-- ================= SECCIÓN 5 ESTRELLAS ================= -->
    <section class="rating-section">
        <div class="rating-header">
            <h2 class="rating-title">
                <span class="rating-stars">★★★★★</span>
                <span class="rating-label">Imprescindibles</span>
