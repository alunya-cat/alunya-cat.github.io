<header class="nav-header">
    <aside class="profile-section">
        <a href="<%= site.url %>">
        <div class="profile-header">
            <div class="avatar-container">
                <img src="https://alunya.cat/logo-b.png" alt="Alunya" class="avatar">
            </div>
            <div class="profile-text">
                <h1><%= site.title %></a></h1>
                <div class="avatar-description">
                    El valor d'intentar-ho.
                </div>
            </div>
        </div>
        </a>
        <div class="nav-links">
            <a href="_usos.html">Usos</a>
            <span class="separator">/</span>
            <a href="_colofo.html">Colofò</a>
            <span class="separator">/</span>
            <a href="books.html">Lecturas</a>
            <span class="separator">/</span>
            <a href="status.html">Sobre mi</a>
        </div>
    </aside>
</header>
<div class="wrapper">
        <main>
            <div class="block">
                <h1 class="post-title"><%= title %></h1>
                <% if description then %>
                    <p class="post-description"><%= description %></p>
                <% end %>
                <hr>
                <% 
-- Configuración de las secciones de estrellas ordenadas
local ratingsConfig = {
    { rating = 5, stars = "★★★★★", label = "Imprescindibles" },
    { rating = 4, stars = "★★★★☆", label = "Muy recomendados" },
    { rating = 3, stars = "★★★☆☆", label = "Entretenidos" },
    { rating = 2, stars = "★★☆☆☆", label = "Decepciones (< 2★)" }
}

local subcategories = {
    { id = "book", name = "Libros y Cómics" },
    { id = "Manga/Manhua", name = "Manga/Manhua" },
    { id = "movie", name = "Películas" },
    { id = "tv", name = "Series" },
    { id = "season", name = "Temporadas" },
    { id = "game", name = "Videojuegos" }
}

-- Bucle principal por cada nivel de estrellas
for _, sec in ipairs(ratingsConfig) do 
    -- Verificamos primero si hay algún libro en esta sección para renderizarla
    local sectionHasBooks = false
    if books then
        for _, b in ipairs(books) do
            if b.rating == sec.rating then
                sectionHasBooks = true
                break
            end
        end
    end

    if sectionHasBooks then
%>
    <section class="rating-section">
        <div class="rating-header">
            <h2 class="rating-title">
                <span class="rating-stars"><%= sec.stars %></span>
                <span class="rating-label"><%= sec.label %></span>
            </h2>
        </div>

        <% 
        for _, subcat in ipairs(subcategories) do 
            local subcatHasBooks = false
            for _, b in ipairs(books) do
                if b.rating == sec.rating and b.category == subcat.id then
                    subcatHasBooks = true
                    break
                end
            end

            if subcatHasBooks then
        %>
            <h3 class="category-subtitle"><%= subcat.name %></h3>
            <div class="book-list-container">
                <% for _, book in ipairs(books) do %>
                    <!-- AHORA COMPARA CON subcat.id -->
                    <% if book.rating == sec.rating and book.category == subcat.id then %>
                        <a <% if book.link then %>href="<%= book.link %>"<% end %> class="book-list-row">
                            <div class="book-list-title">
                                <%= book.title %>
                                <% if book.badge then %>
                                    <span class="book-list-badge"><%= book.badge %></span>
                                <% end %>
                            </div>
                        </a>
                    <% end %>
                <% end %>
            </div>
        <% 
            end 
        end 
        %>
    </section>
<% 
    end 
end 
%>
            </div>
        </main>
    </div>

<footer>
<nav class="footer-nav">
    <div class="nav-left">
        CC BY-SA 4.0 / GPLv3
    </div>

    <div class="nav-center">
    </div>

    <div class="nav-right">
        <input type="checkbox" class="toggle" title="Cambiar tema">
        <a href="https://github.com/alunya-cat/alunya-cat.github.io" aria-label="Github">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
        </a>
        <a href="feed.xml"><svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 11a9 9 0 0 1 9 9"></path>
                <path d="M4 4a16 16 0 0 1 16 16"></path>
                <circle cx="5" cy="19" r="1"></circle>
            </svg></a>
        <label class="contact-toggle">
            <input type="checkbox"> <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span class="email-reveal" style="unicode-bidi: bidi-override; direction: rtl;">
                <%= site.email %>
            </span>
        </label>
    </div>
</nav>
</footer>